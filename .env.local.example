# =============================================================================
# FotoStudio — environment variables
#
# Copy this file to .env.local (which is git-ignored) and fill in the values.
# The site works WITHOUT any of these set (demo data + graceful fallbacks),
# so you can develop the UI before creating any accounts. Features that
# depend on a missing variable are disabled/no-op instead of crashing.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Create a free project at https://supabase.com, then run supabase/schema.sql
# in the SQL editor. Keys are under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, NEVER expose to the client/browser.
# Used by Server Actions (admin CRUD, contact form insert) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Images & Stream (optional, for video uploads via Stream) ------
# Create an API token at https://dash.cloudflare.com/profile/api-tokens with
# the "Read and write to Cloudflare Stream and Images" permission template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 (photo storage) ----------------------------------------------
# Create a bucket at dash.cloudflare.com -> R2, then an API token under
# "Manage R2 API Tokens" with Object Read & Write on that bucket. Enable
# public access on the bucket to get the pub-*.r2.dev URL (or attach a
# custom domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Admin panel authentication ------------------------------------------------
# Hardcoded credentials (no user database / signup flow) for the small team.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Any long random string — used to sign the admin session JWT.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Contact form delivery (optional, at least one recommended) ---------------
# Every submission is always saved to Supabase (if configured) AND forwarded
# to any of the channels below in parallel — the form succeeds if ANY works.

# Google Sheets webhook (e.g. a Google Apps Script Web App URL) to append
# each submission as a new spreadsheet row.
GOOGLE_SHEETS_WEBHOOK_URL=

# Resend (https://resend.com, free tier) to email the studio on every
# submission.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
